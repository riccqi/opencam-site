          <div
            :id="`${id}-panel`"
            role="region"
            :aria-labelledby="`${id}-trigger`"
            x-show="activeAccordion==id"
            x-collapse=""
            style="display: none;"
          >
            <div class="p-4 pt-2 text-slate-300">
              OpenCam’s camera functionality processes recordings locally on your iPhone and works offline.
            </div>
          </div>
        </div>
      </div>
