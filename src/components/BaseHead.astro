---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OpenCam - Open Gate Recording on iPhone",
  description = "Record Open Gate with professional controls, using the full camera sensor. Made for content creators and filmmakers.",
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const socialImageUrl = new URL("/og-image.png", siteOrigin).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "OpenCam",
  operatingSystem: "iOS",
  applicationCategory: "Camera and Video Software",
  description,
  url: canonicalUrl,
};
---

<title>{title}</title>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content="Richard Qi" />

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PJ06QBGDRS"></script>
<script>
  // @ts-ignore - Google Analytics global declarations
  window.dataLayer = window.dataLayer || [];
  // @ts-ignore - Google Analytics global function
  function gtag(){dataLayer.push(arguments);}
  // @ts-ignore - Google Analytics function call
  gtag('js', new Date());
  // @ts-ignore - Google Analytics function call
  gtag('config', 'G-PJ06QBGDRS');
</script>

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="opencam, open gate, 4:3 aspect ratio, apple log,iphone recording, video app, camera app, iOS, iPhone, full sensor, video recording, open gate, 4k, high quality, creator, influencer, instagram, tiktok, tools, gym toks, content creator, social media, reels, ugc, 4:3 video"/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />

<!-- Favicon -->
<link rel="shortcut icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<!-- <link rel="manifest" href="/site.webmanifest"> -->
<link rel="mask-icon" href="/favicon.svg" color="#ffffff">
<meta name="msapplication-TileColor" content="#ffffff">
<meta name="theme-color" content="#ffffff">

<style>
  /* Inter for all text */
  @font-face {
    font-family: 'Inter';
    src: url('https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap');
    font-weight: normal;
    font-style: normal;
  }
  
  @font-face {
    font-family: 'Inter';
    src: url('https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap');
    font-weight: 600;
    font-style: normal;
  }
</style>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=IBM+Plex+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<!-- Alpine and the collapse plugin used by the navigation and FAQ -->
<script defer src="https://unpkg.com/@alpinejs/collapse@3.15.12/dist/cdn.min.js"></script>
<script defer src="https://unpkg.com/alpinejs@3.15.12/dist/cdn.min.js"></script>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
