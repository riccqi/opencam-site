---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatesForm from '../components/global/UpdatesForm.astro';
const enabled = import.meta.env.PUBLIC_UPDATES_ENABLED === 'true' || import.meta.env.PUBLIC_UPDATES_FORM_ENABLED === 'true';
---
<BaseLayout title="OpenCam updates | OpenCam" description="News, features, announcements, and releases from OpenCam. Unsubscribe anytime.">
  <section class="mx-auto max-w-xl px-6 pt-40 pb-24">
    <img src="/opencam.png" alt="" width="64" height="64" class="rounded-2xl mb-8" />
    <h1 class="text-4xl font-medium tracking-tight">Get OpenCam updates</h1>
    <p class="mt-5 text-lg text-slate-300">News, features, announcements, and releases from OpenCam. Unsubscribe anytime.</p>
    <UpdatesForm enabled={enabled} />
  </section>
</BaseLayout>