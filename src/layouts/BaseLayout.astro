---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Floats the navigation over the first section, for pages that open with a full-bleed hero. */
  overlayNav?: boolean;
}

const { title, description, overlayNav = false } = Astro.props;
---
<html
  lang="en"
  class="scroll-smooth selection:bg-orange-200 selection:text-black no-touchevents hydrated"
>
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class="bg-[var(--color-bg-dark)] text-white flex flex-col min-h-svh">
    <Navigation overlay={overlayNav} />
    <main class:list={["grow", overlayNav && "relative"]}><slot /></main>
    <Footer/>
  </body>
</html>
